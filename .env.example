# ==============================================================================
# CSIR NET CBT Mock Exam & Question Pipeline — Environment Variables Example
# Copy to .env for local development (never commit real secrets or API keys).
# ==============================================================================

# --- Question Generation Pipeline (csir_pipeline.py) ---
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=your-azure-foundry-api-key
TAGGER_MODEL=gpt-oss-120b
GEN_MODEL=gpt-5-mini
AB_VERIFY_MODEL=gpt-oss-120b
C_VERIFY_MODEL=Phi-4-reasoning

# --- FastAPI Backend Auth & Security ---
# Generate a strong secret for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-strong-random-secret
# Registration uses single-use invite codes in the DB; generate with:
# python manage_invites.py generate --count 12 --days 14

# --- CORS Origins (comma-separated, no trailing slashes) ---
# Local dev defaults to http://localhost:5173,http://127.0.0.1:5173
# Cloud deployment: set to your Azure Static Web Apps URL, e.g. https://your-app.azurestaticapps.net
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database Configuration ---
# Local SQLite mode (used automatically when TURSO_DATABASE_URL & TURSO_AUTH_TOKEN are empty)
# Relative paths are resolved relative to backend/
LOCAL_DB_PATH=../csir_net.db

# Cloud Turso mode (leave blank locally; set both in Azure Container Apps & when running scripts/sync_questions_to_turso.py)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Frontend (set in frontend/.env or Azure Static Web Apps build environment) ---
VITE_API_BASE_URL=http://localhost:8000
